# =============================================================
# CONSERTA CELL — VARIÁVEIS DE AMBIENTE (PAGAMENTOS & SERVIÇOS)
# =============================================================

# Chave Secreta de API do Asaas
# Obtenha no painel Asaas: Menu -> Minha Conta -> Integrações -> Chave de API
ASAAS_API_KEY=

# Ambiente do Asaas: "sandbox" (testes) ou "production" (produção)
ASAAS_ENVIRONMENT=sandbox

# Token de Validação do Webhook Asaas (configurado nas notificações do Asaas)
ASAAS_WEBHOOK_TOKEN=

# Credenciais Firebase
FIREBASE_API_KEY=

# Chave da API Gemini
GEMINI_API_KEY=